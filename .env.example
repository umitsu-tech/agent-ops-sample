# Langfuse（本のサンプル用に新しいプロジェクトを作って、その鍵を入れる）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Knowledge Bases（社内規程の検索先。デプロイ後に出力される PolicyKnowledgeBaseId を書く）
KNOWLEDGE_BASE_ID=
# 1回の検索で取ってくるチャンクの数（1〜20、既定は5）
# KNOWLEDGE_BASE_TOP_K=5

# TypeSafe AI（Jev で採点するのに使う）
TYPESAFE_API_KEY=
